# MODE: real 또는 dummy
MODE=dummy

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:8000

# DB
PG_DSN=postgresql://postgres:1234@127.0.0.1:5432/energydb

# Modbus (전력량계)
MODBUS_PORT=COM7
MODBUS_BAUDRATE=9600
MODBUS_4W_IDS=11,12,13  # 3상 4선식
MODBUS_3W_IDS=14,15     # 3상 3선식
MODBUS_POLL_INTERVAL=5  # 5초마다 수집
MODBUS_MAX_FAILS=3

# Env (온/습도)
ENV_PORT=COM8
ENV_DEVICE_IDS=21,22,23
ENV_POLL_INTERVAL=5     # 5초마다 수집

# Solar (일사량)
SOLAR_PORT=COM8
SOLAR_DEVICE_IDS=31
SOLAR_POLL_INTERVAL=5   # 5초마다 수집

# API base URL (프론트에서 사용하는 값, dev용)
VITE_API_BASE=http://localhost:8000
