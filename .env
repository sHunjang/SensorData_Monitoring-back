# ============================================================
# 실행 모드 설정
# ============================================================
# MODE: real (실제 장비) 또는 dummy (더미 데이터)
# MODE=real
MODE=real


# ============================================================
# CORS 설정 (프론트엔드 허용 URL)
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:8000


# ============================================================
# 데이터베이스 설정
# ============================================================
PG_DSN=postgresql://postgres:1234@127.0.0.1:5432/energydb


# ============================================================
# Modbus 설정 (전력량계 TAC4300)
# ============================================================
MODBUS_PORT=COM7
MODBUS_BAUDRATE=9600
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_BYTESIZE=8

# 디바이스 ID 설정 (bootstrap.py 스키마 기준)
MODBUS_4W_IDS=11,12,13  # 3상 4선식 (Line-to-Line 전압)
MODBUS_3W_IDS=14,15     # 3상 3선식 (Line-to-Neutral 전압)

# 수집 설정
MODBUS_POLL_INTERVAL=5  # 5초마다 수집
MODBUS_MAX_FAILS=3      # 연속 3회 실패 시 비활성화


# ============================================================
# 환경센서 설정 (온/습도)
# ============================================================
ENV_PORT=COM8
ENV_DEVICE_IDS=21,22,23 # 환경센서 ID (온도/습도)
ENV_POLL_INTERVAL=5     # 5초마다 수집


# ============================================================
# 태양광센서 설정 (일사량)
# ============================================================
SOLAR_PORT=COM8
SOLAR_DEVICE_IDS=31     # 태양광센서 ID (일사량 W/m²)
SOLAR_POLL_INTERVAL=5   # 5초마다 수집


# ============================================================
# API 설정 (프론트엔드용)
# ============================================================
# VITE_API_BASE: React 프론트엔드에서 사용하는 백엔드 API 주소
VITE_API_BASE=http://localhost:8000
